.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code extensions
*.vsix

### Visual Studio Code Patch ###
.history
.ionide

### Web Development ###
# Dependencies
node_modules/

# Generated files
dist/
coverage/

# Environment variables and secrets
.env
.env.*
!.env.example

